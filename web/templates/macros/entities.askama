{% macro artist_link(artistread) -%}
<a href="/artist/{{ artistread.id }}">{{ artistread.name }}</a>
{%- endmacro %}

{% macro artist_cell(artistread) -%}
<td>
    {{ artist_link(artistread) }}
</td>
{%- endmacro %}

{% macro track_link(trackread) -%}
<a href="/track/{{ trackread.id }}">{{ trackread.title }}</a>
{%- endmacro %}

{% macro track_cell(trackread) -%}
<td>
    <span class="secondary_cell_info">{{ artist_links(trackread.artists) }}</span> –
    {{ track_link(trackread) }}
</td>
{%- endmacro %}


{% macro album_link(albumread) -%}
<a href="/album/{{ albumread.id }}">{{ albumread.album_title }}</a>
{%- endmacro %}

{% macro album_cell(albumread) -%}
<td>
    <span class="secondary_cell_info">{{ artist_links(albumread.artists) }}</span> –
    {{ album_link(albumread) }}
</td>
{%- endmacro %}

{% macro artist_links(artistreads) -%}
    {% if artistreads.len() == 0 %}{{ config.default_artist }}{% endif %}
    {% for artistread in artistreads -%}
        {{ artist_link(artistread) -}}
        {% if !loop.last %}, {% endif %}
    {%- endfor %}

{%- endmacro %}


{% macro limit_entity_desc(artist, track, album) %}
    {%- match album -%}
        {%- when Some with (album) -%}
        of {{ album_link(album) }}
        {%- when None -%}
    {%- endmatch -%}
    {%- match artist -%}
        {%- when Some with (artist) -%}
        of {{ artist_link(artist) }}
        {%- when None -%}
    {%- endmatch -%}
    {%- match track -%}
        {%- when Some with (track) -%}
        of {{ track_link(track) }}
        {%- when None -%}
    {%- endmatch -%}
{% endmacro %}